---
import { LinkButton } from "@astrojs/starlight/components";
import logo from "../assets/logo-mark.svg";
import { BASE } from "../lib/site.mjs";

const { title, tagline, actions = [] } = Astro.locals.starlightRoute.entry.data.hero ?? {};

const href = (link: string) =>
	/^[a-z]+:/i.test(link) ? link : `${BASE}/${link.replace(/^\/+/, "")}/`;
---

<div class="tr-hero">
	<img class="tr-hero__logo" src={logo.src} width="64" height="64" alt="" />
	<p class="tr-hero__eyebrow">Documentation</p>
	<h1 id="_top" data-page-title>{title}</h1>
	<p class="tr-hero__tagline">{tagline}</p>
	<div class="tr-hero__actions">
		{
			actions.map((action) => (
				<LinkButton href={href(action.link)} variant={action.variant}>
					{action.text}
				</LinkButton>
			))
		}
	</div>
</div>

<style is:global>
	.tr-hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 1rem;
		padding-block: 2rem 1rem;
	}
	.tr-hero__logo {
		width: 4rem;
		height: 4rem;
		border-radius: 1rem;
		box-shadow: 0 0 3rem -0.5rem var(--tr-glow);
	}
	.tr-hero__eyebrow {
		margin: 0;
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-xs);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--sl-color-accent-high);
	}
	.tr-hero h1 {
		margin: 0;
		font-size: clamp(var(--sl-text-3xl), calc(0.25rem + 5vw), var(--sl-text-5xl));
		line-height: var(--sl-line-height-headings);
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--sl-color-white);
	}
	.tr-hero__tagline {
		margin: 0;
		max-width: 38ch;
		font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
		color: var(--sl-color-gray-2);
		text-wrap: balance;
	}
	.tr-hero__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		margin-top: 0.5rem;
	}
</style>
